# Copy this file to .env and fill in real values before starting the stack.
# Generate strong random values, e.g.: openssl rand -base64 48

# PostgreSQL password for the rustdesk_directory database/role.
DATABASE_PASSWORD=

# Signing secret for issued session/access tokens.
TOKEN_SIGNING_SECRET=

# Secret used to derive per-device credential material.
DEVICE_CREDENTIAL_SECRET=

# Secret used to encrypt stored TOTP (2FA) seeds at rest.
TOTP_ENCRYPTION_SECRET=
