# Copy this file to .env and fill in real values before starting the stack.
# Generate strong random values, e.g.: openssl rand -base64 48

# PostgreSQL password for the rustdesk_directory database/role.
DATABASE_PASSWORD=

# Signing secret for issued session/access tokens.
TOKEN_SIGNING_SECRET=

# Secret used to derive per-device credential material.
DEVICE_CREDENTIAL_SECRET=

# Secret used to encrypt stored TOTP (2FA) seeds at rest.
TOTP_ENCRYPTION_SECRET=

# RustDrop: where the blob-storage backend (see the rustdrop-storage repo)
# is reachable and the bearer secret it expects. Both required.
RUSTDROP_STORAGE_BASE_URL=
RUSTDROP_STORAGE_SECRET=

# Optional (leave empty until needed; the API still starts without them).
# Shared secret the host health collector sends to the internal health-event endpoint (same value as /etc/rustdesk-health-watcher/secret); empty disables that endpoint.
HEALTH_WATCHER_SHARED_SECRET=
# Firebase project id for mobile companion app push (also needs config/firebase-adminsdk.json); empty means push is a no-op.
FIREBASE_PROJECT_ID=
# Secret used to encrypt the stored outbound-mail (SMTP) password at rest; until set, no SMTP password can be saved and alert email is off.
SMTP_ENCRYPTION_SECRET=
# Device-certificate authority for peer authentication: base64 of a random 32-byte Ed25519 private key, e.g.
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Empty disables certificate issuance. Build the client with RUSTDESK_MANAGED_PEER_CA_PUBKEY set to the
# matching public key (GET /v1/peer-auth/ca returns it once this is set). Keep the private key only here.
PEER_CA_PRIVATE_KEY=

# Cloudflare mTLS client certificates for the RDS edge (app/edge_certs.py): an API token allowed to
# manage client certificates, and the zone ID. Empty disables issuance.
CF_EDGE_CERT_TOKEN=
CF_ZONE_ID=

# Sealed transport (app/sealed.py): RDS's X25519 private key (base64). Build the client with
# RUSTDESK_MANAGED_SEAL_PUBKEY set to the matching public key. The previous key keeps clients built
# before a rotation working. SEALED_REQUIRE_EDGE_CERT=1 refuses sealed calls that arrive without a
# verified edge client certificate, except enrollment/bootstrap calls. A call that reports TLS
# interception (it can't carry the certificate) is then served only from an approved network and
# only for a device that holds an active edge certificate; without a device credential it is
# refused.
SEALED_X25519_PRIVATE_KEY=
SEALED_X25519_PREVIOUS_PRIVATE_KEY=
SEALED_REQUIRE_EDGE_CERT=

# Device passports (app/ca_link.py, ca/): the address the ca-link container listens on for the CA VM's
# signer - an internal interface only the CA VM can reach (empty = 127.0.0.1 only). Its TLS files go in
# config/ca-link/ (server.key, server.crt, and link-ca.crt, the CA that signed the signer's client cert).
CA_LINK_BIND=

# Not read from this file - compose.yml sets these to fixed in-container values:
#   DATABASE_HOST=database  DATABASE_PORT=5432  DATABASE_NAME=rustdesk_directory  DATABASE_USER=rustdesk_directory
#   FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-adminsdk.json   (mounted from config/firebase-adminsdk.json)
#   RUSTDROP_STORAGE_CERT_PATH=/run/secrets/rustdrop-storage-ca.pem     (mounted from config/rustdrop-storage-ca.pem)

# Not read from this file - optional overrides for deploy/sbin/rustdesk-health-collector,
# set in its systemd unit (Environment=) if the defaults below do not fit your host:
#   RUSTDESK_OPS_SOURCE_STATE=/srv/rustdesk-updates/source-patches/source-state.json
#   RUSTDESK_OPS_ORIGIN_CA_BUNDLE=/usr/local/share/rustdesk-directory-ops/cloudflare-origin-ca-bundle.pem
#   RUSTDESK_OPS_HOST_METRICS_HOSTNAME=hypervisor
