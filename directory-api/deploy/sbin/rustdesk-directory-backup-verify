#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

DEST="/var/backups/rustdesk-directory"
OPS="/var/lib/rustdesk-directory-ops"
STATUS="$OPS/backup-verify.json"
LOG="/var/log/rustdesk-directory-backup-verify.log"
DB_CONTAINER="rustdesk-directory-db"
LOCK="/run/lock/rustdesk-directory-backup-verify.lock"

mkdir -p "$OPS" "$(dirname "$LOCK")"
chmod 0755 "$OPS"
exec 9>"$LOCK"

if ! flock -n 9; then
    exit 0
fi

# Best-effort report to the same health-event endpoint/secret the RDS
# health-watcher already uses - reuses its existing debounce+notification
# path (push + email) rather than inventing a second one. Must never affect
# the verify run itself, hence the trailing `|| true` and early `return 0`s.
report_health_event() {
    local condition_key="$1" is_active="$2" detail="$3"
    local secret
    secret="$(cat /etc/rustdesk-health-watcher/secret 2>/dev/null)" || return 0
    [[ -n "$secret" ]] || return 0
    local escaped_detail url
    escaped_detail="$(printf '%s' "$detail" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    # Loopback first (directory-api's own port, published on 127.0.0.1 only), so a failure of the
    # reverse proxy, edge proxy, CDN/WAF or WAN link can't swallow the report; the public URL is
    # only the fallback.
    for url in "http://127.0.0.1:21120/ops/api/mobile/internal/health-event" \
        "https://ops.example.com/ops/api/mobile/internal/health-event"; do
        curl -fsS -m 15 -X POST \
            "$url" \
            -H "Content-Type: application/json" \
            -H "X-Health-Watcher-Secret: $secret" \
            -A "rustdesk-directory-backup-verify/1.0" \
            -d "{\"condition_key\":\"$condition_key\",\"is_active\":$is_active,\"detail\":\"$escaped_detail\"}" \
            >/dev/null 2>&1 && return 0
    done
    return 0
}

# Whether a restored row count ($3) is close enough to the one recorded at backup time ($2) for
# table $1. The backup counts rows just after pg_dump, outside its snapshot, and some tables change
# every few seconds (relay lease renewals, sessions, audit events), so exact equality failed by
# chance. The singleton and the operator accounts must still match exactly; elsewhere the restored
# count may differ by max(25, 5%), and a table counted non-empty must not restore empty, which
# still catches an empty or truncated restore.
row_count_matches() {
    local table="$1" expected="$2" actual="$3" allowed diff
    if [[ ! "$expected" =~ ^[0-9]+$ || ! "$actual" =~ ^[0-9]+$ ]]; then
        return 1
    fi
    expected=$((10#$expected))
    actual=$((10#$actual))
    case "$table" in
        directory_instance|operator_accounts)
            [[ "$actual" -eq "$expected" ]]
            return
            ;;
    esac
    if [[ "$expected" -gt 0 && "$actual" -eq 0 ]]; then
        return 1
    fi
    allowed=$((expected * 5 / 100))
    if [[ "$allowed" -lt 25 ]]; then
        allowed=25
    fi
    diff=$((actual - expected))
    if [[ "$diff" -lt 0 ]]; then
        diff=$((-diff))
    fi
    [[ "$diff" -le "$allowed" ]]
}

latest="$(
    find "$DEST" -mindepth 1 -maxdepth 1 -type d -name 'daily-*' \
        -printf '%T@|%p\n' 2>/dev/null |
    sort -n |
    tail -n 1 |
    cut -d'|' -f2-
)"

write_status() {
    local state="$1"
    local detail="$2"
    local backup_path="${3:-$latest}"
    python3 - "$STATUS" "$state" "$detail" "$backup_path" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

path = Path(sys.argv[1])
payload = {
    "status": sys.argv[2],
    "detail": sys.argv[3],
    "backup_path": sys.argv[4] or None,
    "last_verified_at": datetime.now(timezone.utc).isoformat(),
}
tmp = path.with_suffix(".tmp")
with tmp.open("w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

fail() {
    local message="$1"
    write_status "failed" "$message"
    printf '%s RESTORE_VERIFY_FAILED backup=%s detail=%s\n' \
        "$(date -u +%FT%TZ)" "${latest:-none}" "$message" >> "$LOG"
    report_health_event "backup_verify" "true" "$message"
    echo "ERROR: $message" >&2
    exit 1
}

[[ -n "$latest" ]] || fail "No daily RustDesk Directory backup exists"
[[ -s "$latest/database.dump" ]] || fail "Latest backup database.dump is missing or empty"
[[ -s "$latest/SHA256SUMS" ]] || fail "Latest backup SHA256SUMS is missing"

(
    cd "$latest"
    sha256sum -c SHA256SUMS
) >/tmp/rustdesk-backup-verify-sha.txt 2>&1 || {
    cat /tmp/rustdesk-backup-verify-sha.txt >&2 || true
    fail "Backup checksum verification failed"
}

DB_IMAGE="$(docker inspect "$DB_CONTAINER" --format '{{.Config.Image}}')"
[[ -n "$DB_IMAGE" ]] || fail "Unable to determine the PostgreSQL image"

VERIFY_CONTAINER="rustdesk-backup-verify-$$-$RANDOM"
VERIFY_PASSWORD="$(openssl rand -hex 24)"

cleanup() {
    docker rm -f "$VERIFY_CONTAINER" >/dev/null 2>&1 || true
    rm -f /tmp/rustdesk-backup-verify-sha.txt
}
trap cleanup EXIT

docker run -d --name "$VERIFY_CONTAINER" \
    -e POSTGRES_USER=verify \
    -e POSTGRES_PASSWORD="$VERIFY_PASSWORD" \
    -e POSTGRES_DB=verify_db \
    "$DB_IMAGE" >/dev/null

ready=0
# Over TCP: the image's first-start init server listens on the socket only and answers there before
# verify_db exists, so a socket check could pass during init and pg_restore then find no database.
for _ in $(seq 1 60); do
    if docker exec "$VERIFY_CONTAINER" \
        pg_isready -h 127.0.0.1 -U verify -d verify_db >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
[[ "$ready" == "1" ]] || fail "Temporary PostgreSQL restore container did not become ready"

docker exec -i "$VERIFY_CONTAINER" \
    pg_restore \
    -U verify \
    -d verify_db \
    --no-owner \
    --no-privileges \
    < "$latest/database.dump" \
    >/tmp/rustdesk-backup-restore.log 2>&1 || {
        tail -n 100 /tmp/rustdesk-backup-restore.log >&2 || true
        fail "pg_restore failed"
    }

required_tables=(
    directory_instance
    operator_accounts
    operator_sessions
    managed_devices
    device_credentials
    audit_events
    relay_access_leases
    device_reenrollment_authorizations
)

for table in "${required_tables[@]}"; do
    exists="$(
        docker exec "$VERIFY_CONTAINER" psql -X -Atq \
            -U verify -d verify_db \
            -c "SELECT CASE WHEN to_regclass('public.${table}') IS NULL THEN 0 ELSE 1 END;"
    )"
    [[ "$exists" == "1" ]] || fail "Restored database is missing table: $table"
done

instance_count="$(
    docker exec "$VERIFY_CONTAINER" psql -X -Atq \
        -U verify -d verify_db \
        -c "SELECT COUNT(*) FROM directory_instance WHERE singleton=TRUE;"
)"
[[ "$instance_count" == "1" ]] || fail "Restored directory_instance singleton validation failed"

owner_count="$(
    docker exec "$VERIFY_CONTAINER" psql -X -Atq \
        -U verify -d verify_db \
        -c "SELECT COUNT(*) FROM operator_accounts WHERE role='owner';"
)"
[[ "$owner_count" -ge 1 ]] || fail "Restored database contains no Owner account"

if [[ -s "$latest/DB-COUNTS.tsv" ]]; then
    while IFS='|' read -r table expected; do
        [[ -n "$table" ]] || continue
        actual="$(
            docker exec "$VERIFY_CONTAINER" psql -X -Atq \
                -U verify -d verify_db \
                -c "SELECT COUNT(*) FROM ${table};"
        )"
        row_count_matches "$table" "$expected" "$actual" \
            || fail "Row-count mismatch for ${table}: expected ${expected}, restored ${actual}"
    done < "$latest/DB-COUNTS.tsv"
fi

write_status "ok" "Backup restored successfully into an isolated PostgreSQL container"
printf '%s RESTORE_VERIFY_OK backup=%s\n' \
    "$(date -u +%FT%TZ)" "$latest" >> "$LOG"
report_health_event "backup_verify" "false" \
    "Backup restored successfully into an isolated PostgreSQL container"

trap - EXIT
cleanup
rm -f /tmp/rustdesk-backup-restore.log
echo "RESTORE_VERIFY_OK backup=$latest"
